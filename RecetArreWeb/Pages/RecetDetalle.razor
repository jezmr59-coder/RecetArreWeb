@page "/recetas/{Id:int}"
@inject IRecetaService recetaService
@inject IComentarioService comentarioService
@inject NavigationManager navigation
@inject AuthenticationStateProvider authStateProvider
@using RecetArreWeb.DTOs
@using RecetArreWeb.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>@(receta?.Titulo ?? "Receta")</PageTitle>

@if (receta == null)
{
    <div class="container py-5 text-center">
        <div class="spinner-border text-brand" role="status"></div>
        <p class="text-muted mt-3">Cargando receta...</p>
    </div>
}
else
{
    <div class="container py-4">
        <!-- Botón volver -->
        <div class="mb-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick='() => navigation.NavigateTo("/recetas")'>
                <span class="bi bi-arrow-left"></span> Volver a recetas
            </button>
        </div>

        <!-- Encabezado de la receta -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">4
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h1 class="h2 text-brand mb-0">@receta.Titulo</h1>
                    @if (!receta.EstaPublicado)
                    {
                        <span class="badge bg-warning text-dark">Borrador</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(receta.Descripcion))
                {
                    <p class="text-muted mb-3">@receta.Descripcion</p>
                }

                <!-- Métricas -->
                <div class="row g-3 mb-3">
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <div class="h4 text-brand mb-0">@receta.TiempoPreparacionMinutos</div>
                            <small class="text-muted">min preparación</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <div class="h4 text-brand mb-0">@receta.TiempoCoccionMinutos</div>
                            <small class="text-muted">min cocción</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <div class="h4 text-brand mb-0">@receta.Porciones</div>
                            <small class="text-muted">porciones</small>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <div class="h4 text-brand mb-0">@PromedioEstrellas.ToString("0.0")</div>
                            <small class="text-muted">puntuación</small>
                        </div>
                    </div>
                </div>

                <!-- Categorías -->
                @if (receta.Categorias.Any())
                {
                    <div class="mb-3">
                        @foreach (var cat in receta.Categorias)
                        {
                            <span class="badge bg-brand me-1">@cat</span>
                        }
                    </div>
                }

                <!-- Ingredientes -->
                @if (receta.Ingredientes.Any())
                {
                    <div class="mb-3">
                        <h5>Ingredientes</h5>
                        <ul class="list-group list-group-flush">
                            @foreach (var ing in receta.Ingredientes)
                            {
                                <li class="list-group-item px-0">
                                    <span class="bi bi-check2-circle text-brand me-2"></span>@ing.Nombre
                                </li>
                            }
                        </ul>
                    </div>
                }

                <!-- Instrucciones -->
                <div>
                    <h5>Instrucciones</h5>
                    <p class="text-muted" style="white-space: pre-line">@receta.Instrucciones</p>
                </div>
            </div>
        </div>

        <!-- Sección de comentarios -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <span class="bi bi-chat-dots me-2"></span>
                    Comentarios (@comentarios.Count)
                </h5>

            </div>

            <div class="card-body">

                <!-- Alertas -->
                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        @mensajeError
                        <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(mensajeExito))
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @mensajeExito
                        <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
                    </div>
                }

                <!-- Formulario nuevo comentario -->
                <AuthorizeView>
                    <Authorized>
                        <div class="card border-0 bg-light mb-4">

                            <div class="card-body">

                                <h6 class="mb-3">Deja tu comentario</h6>

                                <!-- Estrellas -->
                                <div class="mb-3">
                                    <label class="form-label">Puntuación</label>
                                    <div class="d-flex gap-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            var estrella = i;
                                            <span class="fs-4 cursor-pointer"
                                                  style="cursor:pointer; color: @(estrella <= nuevoComentario.Puntuacion ? "#ffc107" : "#dee2e6")"
                                                  @onclick="() => nuevoComentario.Puntuacion = estrella">
                                                ★
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Comentario</label>
                                    <textarea class="form-control" rows="3"
                                              @bind="nuevoComentario.Contenido"
                                              placeholder="Escribe tu comentario..."></textarea>
                                </div>

                                <button class="btn btn-brand" @onclick="EnviarComentario" disabled="@enviando">
                                    @if (enviando)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Publicar comentario
                                </button>
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="alert alert-info mb-4">
                            <a href="/login" class="alert-link">Inicia sesión</a> para dejar un comentario.
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Lista de comentarios -->
                @if (cargandoComentarios)
                {
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-brand"></div>
                    </div>
                }
                else if (!comentarios.Any())
                {
                    <p class="text-muted text-center py-3">Aún no hay comentarios. ¡Sé el primero!</p>
                }
                else
                {
                    @foreach (var comentario in comentarios)
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="fw-semibold">@(comentario.UsuarioEmail ?? "Usuario")</span>
                                    <span class="ms-2">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span style="color: @(i <= comentario.Puntuacion ? "#ffc107" : "#dee2e6")">★</span>
                                        }
                                    </span>
                                    <small class="text-muted ms-2">@comentario.CreadoUtc.ToString("dd/MM/yyyy")</small>
                                </div>

                                <!-- Botón eliminar solo para el autor -->
                                @if (comentario.UsuarioEmail == emailUsuarioActual)
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => EliminarComentario(comentario.Id)">
                                        <span class="bi bi-trash"></span>
                                    </button>
                                }
                            </div>
                            <p class="mb-0 mt-2">@comentario.Contenido</p>
                        </div>
                    }
                }

            </div>

        </div>

    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private RecetaDto? receta;
    private List<ComentarioDto> comentarios = new();
    private ComentarioCreacionDto nuevoComentario = new() { Puntuacion = 5 };
    private bool cargandoComentarios = true;
    private bool enviando = false;
    private string mensajeError = "";
    private string mensajeExito = "";
    private string? emailUsuarioActual;

    private double PromedioEstrellas => comentarios.Any()
        ? Math.Round(comentarios.Average(c => c.Puntuacion), 1)
        : 0;

    protected override async Task OnInitializedAsync()
    {
        // Obtener email del usuario logueado
        var authState = await authStateProvider.GetAuthenticationStateAsync();
        emailUsuarioActual = authState.User.FindFirst(ClaimTypes.Email)?.Value
                          ?? authState.User.FindFirst("email")?.Value;

        await Task.WhenAll(CargarReceta(), CargarComentarios());
    }

    private async Task CargarReceta()
    {
        receta = await recetaService.ObtenerRecetaPorId(Id);
        if (receta == null)
            navigation.NavigateTo("/recetas");
    }

    private async Task CargarComentarios()
    {
        cargandoComentarios = true;
        comentarios = await comentarioService.ObtenerPorReceta(Id);
        cargandoComentarios = false;
    }

    private async Task EnviarComentario()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentario.Contenido))
        {
            mensajeError = "El comentario no puede estar vacío.";
            return;
        }

        enviando = true;
        mensajeError = "";

        nuevoComentario.RecetaId = Id;
        var resultado = await comentarioService.Crear(nuevoComentario);

        if (resultado != null)
        {
            mensajeExito = "Comentario publicado exitosamente.";
            nuevoComentario = new ComentarioCreacionDto { Puntuacion = 5 };
            await CargarComentarios();
        }
        else
        {
            mensajeError = "No se pudo publicar el comentario.";
        }

        enviando = false;
    }

    private async Task EliminarComentario(int comentarioId)
    {
        var ok = await comentarioService.Eliminar(comentarioId);
        if (ok)
        {
            mensajeExito = "Comentario eliminado.";
            await CargarComentarios();
        }
        else
        {
            mensajeError = "No se pudo eliminar el comentario.";
        }
    }
}
